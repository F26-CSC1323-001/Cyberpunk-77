class Rectangle:
    def __init__(self, l, w):
        self.length = l
        self.width = w

    # def draw (self):
    #     for i in range(self.width):
    #         print("* " * self.length)

    def __str__ (self):
        return "\n".join("* " * self.length for i in range(self.width))
r1 = Rectangle (3, 4)
print (r1)


